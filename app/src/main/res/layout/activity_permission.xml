<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/permission_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/permission_card_background"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/permission_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/draw_overlay_permission_title"
            android:textAppearance="@style/TextAppearance.TermuxFloat.HeadlineSmall" />

        <TextView
            android:id="@+id/permission_explanation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/draw_overlay_permission_explanation"
            android:textAppearance="@style/TextAppearance.TermuxFloat.BodyMedium" />

        <Button
            android:id="@+id/grant_permission_button"
            style="@style/Widget.TermuxFloat.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="24dp"
            android:text="@string/grant_permission" />
    </LinearLayout>

</FrameLayout>