<?xml version="1.0" encoding="utf-8"?>
<!-- Session picker: Material Design 3 dialog with a session list and a create row -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sessions_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/sessions_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/sessions_dialog_title"
        android:textAppearance="@style/TextAppearance.TermuxFloat.HeadlineSmall" />

    <TextView
        android:id="@+id/sessions_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/sessions_dialog_hint"
        android:textAppearance="@style/TextAppearance.TermuxFloat.BodyMedium" />

    <TextView
        android:id="@+id/sessions_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/sessions_dialog_empty"
        android:textAppearance="@style/TextAppearance.TermuxFloat.BodyMedium"
        android:visibility="gone" />

    <ScrollView
        android:id="@+id/sessions_scroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/session_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <EditText
        android:id="@+id/new_session_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="@string/sessions_dialog_new_session_hint"
        android:importantForAutofill="no"
        android:inputType="text"
        android:maxLength="48"
        android:maxLines="1"
        android:textColor="@color/md_theme_dark_on_surface"
        android:textColorHint="@color/md_theme_dark_on_surface_variant" />

    <Button
        android:id="@+id/create_session_button"
        style="@style/Widget.TermuxFloat.Button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="12dp"
        android:text="@string/sessions_dialog_create" />

</LinearLayout>
