<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Material Design 3 baseline dark color scheme. Termux:Float chrome runs dark so that it
        blends with the terminal colors, so only the dark tokens are defined here.
        https://m3.material.io/styles/color/roles
    -->
    <color name="md_theme_dark_primary">#FFD0BCFF</color>
    <color name="md_theme_dark_on_primary">#FF381E72</color>
    <color name="md_theme_dark_surface">#FF141218</color>
    <color name="md_theme_dark_on_surface">#FFE6E0E9</color>
    <color name="md_theme_dark_surface_container">#FF211F26</color>
    <color name="md_theme_dark_surface_container_high">#FF2B2930</color>
    <color name="md_theme_dark_on_surface_variant">#FFCAC4D0</color>
    <color name="md_theme_dark_outline_variant">#FF49454F</color>

    <!-- State layer: on-surface @ 12% opacity, used for ripple/state feedback -->
    <color name="md_theme_dark_state_layer">#1FFFFFFF</color>

    <!-- State layer over primary container surfaces: on-primary @ 12% opacity -->
    <color name="md_theme_dark_on_primary_state_layer">#1F381E72</color>
</resources>
