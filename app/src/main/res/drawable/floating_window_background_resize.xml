<?xml version="1.0" encoding="utf-8"?>
<!-- Window background while in long press state: primary outline hints at the movability.
     The header layer matches floating_window_background so the look stays consistent. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/floating_window_corner_radius" />
            <stroke
                android:width="@dimen/floating_window_border_width"
                android:color="@color/md_theme_dark_primary" />
            <solid android:color="@color/md_theme_dark_surface" />
        </shape>
    </item>
    <item
        android:drawable="@drawable/floating_window_controls_background"
        android:top="@dimen/floating_window_border_width"
        android:left="@dimen/floating_window_border_width"
        android:right="@dimen/floating_window_border_width"
        android:height="@dimen/floating_window_header_height"
        android:gravity="top|fill_horizontal" />
</layer-list>
