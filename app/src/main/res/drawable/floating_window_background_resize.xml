<?xml version="1.0" encoding="utf-8"?>
<!-- Window background while in long press state: primary outline hints at the movability -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >
    <corners android:radius="@dimen/floating_window_corner_radius" />
    <stroke
        android:width="@dimen/floating_window_border_width"
        android:color="@color/md_theme_dark_primary" />
    <solid android:color="@color/md_theme_dark_surface" />
</shape>
